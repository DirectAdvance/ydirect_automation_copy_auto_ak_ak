[Unit]
Description=SEOAdvanced Direct Create (web UI, создание РК — нейродиректолог)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/scripts/home/seoadvanced
Environment=DIRECT_HOST=127.0.0.1
Environment=DIRECT_PORT=5020
Environment=DIRECT_REGISTER_CONTENT_EDITOR=0
# Копирование кампаний вынесено в direct-copy.service (своя очередь). Выключаем его здесь,
# чтобы рестарт этого сервиса не трогал очередь копирования, и наоборот. Убрать (или '1'),
# чтобы вернуть копирование в основной процесс (single-process режим).
Environment=DIRECT_REGISTER_COPY=0
# Phase 2 (split web/worker) — ACTIVE on prod (LXC 101, 2026-07): this process serves the
# UI only. It POSTS jobs to the Victory DB (status='queued', _web_posted=true) and reads
# status/queue from the DB — it does NOT run the worker pool or daemons, so deploying/
# restarting the UI no longer kills in-flight jobs. Campaign creation runs in
# direct-create-worker.service (DIRECT_ROLE=worker). Start direct-create-worker.service FIRST.
# NOTE: on prod DIRECT_ROLE=web is ALSO applied via drop-in deploy/dropins/direct-create.service.d/
# role.conf (drop-ins are additive and win). This line keeps the tracked unit self-documenting;
# to revert to single-process, set DIRECT_ROLE=all here AND remove the role.conf drop-in.
Environment=DIRECT_ROLE=web
ExecStart=/root/venv/bin/python3 -m direct.main
Restart=always
RestartSec=5

# In DIRECT_ROLE=all (default) the Direct queue and throttling are intentionally
# single-process in memory. Do not run this app with multiple workers or the Werkzeug
# reloader. In the split setup (DIRECT_ROLE=web here + direct-create-worker.service) the queue
# lives in the worker process; this one only talks to it through the Victory DB.

[Install]
WantedBy=multi-user.target
